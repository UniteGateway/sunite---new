# Copy to .env. Never commit real secrets.
SUNITE_ENV=development                 # production refuses SUNITE_AUTH_MODE=local_demo
SUNITE_DB_PATH=./sunite.sqlite3
SUNITE_AUTH_MODE=required              # or local_demo (single-user, local machine only)
SUNITE_BASE_URL=http://localhost:8000  # used in verification / reset links
SUNITE_SESSION_TTL_MIN=720
SUNITE_SESSION_IDLE_MIN=120
SUNITE_RESET_TTL_MIN=30
SUNITE_MAX_FAILED_LOGINS=5
SUNITE_LOCKOUT_MIN=15
# Email delivery for `python -m backend.cli send-outbox`
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
# Planned: DATABASE_URL (PostgreSQL), GEMINI_API_KEY, MAP_TILE_URL / MAP_TILE_API_KEY
# Map workspace tile layers (choose licensed providers for production)
SUNITE_TILE_STREET_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SUNITE_TILE_STREET_ATTRIBUTION=© OpenStreetMap contributors
SUNITE_TILE_SATELLITE_URL=
SUNITE_TILE_SATELLITE_ATTRIBUTION=
# Gemini (AI assistant + AI roof detection). Server-side only: never put the key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest      # pin a current stable id in production; run `python -m backend.cli ai-check`
GEMINI_TIMEOUT_S=60
GEMINI_MAX_RETRIES=3
AI_DAILY_REQUESTS_PER_ORG=500         # cost control
